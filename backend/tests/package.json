{
  "name": "ascend-rules-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Suite de tests de las reglas de seguridad de Firestore y Storage",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project ascend-test \"vitest run\"",
    "test:watch": "firebase emulators:exec --only firestore,storage --project ascend-test \"vitest\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "vitest": "^2.1.8"
  }
}
